#compdef lore
# zsh completion for lore. lore itself says what can come next
# (`lore --complete WORDS`), with what each one is; with nothing to offer,
# file names. Installed by the packages; or, in a folder on your $fpath:
#   lore --completions zsh > ~/.zfunc/_lore

_lore() {
    local -a found items
    local line
    found=("${(@f)$(lore --complete "${(@)words[2,CURRENT]}" 2>/dev/null)}")
    for line in $found; do
        [[ -z $line ]] && continue
        # `name<TAB>what it is` → `name:what it is` (a `:` in the name escaped)
        items+=("${${line%%$'\t'*}//:/\\:}:${line#*$'\t'}")
    done
    if (( ${#items} )); then
        _describe 'lore' items
    else
        _files
    fi
}

_lore "$@"
