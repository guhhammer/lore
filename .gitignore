# Cargo.lock is NOT ignored, on purpose: lore is an application, and its
# lockfile records which dependency versions went into the shipped binary.

# Build output; cli/clean removes it.
/target/

# cli/make copies the release binary here. The folder is tracked through its
# .gitkeep; the binaries never are.
/app/*
!/app/.gitkeep

# The owner's open-work notes stay out of the public repository.
.todo
.todo.distros
.todo.context

# AI tooling stays local: the agents' instruction files and their folders.
CLAUDE.md
CLAUDE.local.md
AGENTS.md
AGENT.md
GEMINI.md
CODEX.md
.cursorrules
.windsurfrules
.github/copilot-instructions.md
.mcp.json
.claude/
.codex/
.agents/
.gemini/
.cursor/
.windsurf/
.continue/
.aider*

# Local knowledge tools: the code graph and the memory palace (and what their
# setup writes next to them). Never pushed.
graphify-out/
.graphify*
.mempalace/
mempalace.yaml
mempalace.yml
entities.json

# Drafts of command pages, reviewed before they move into content/.
/.content-draft/

# Python bytecode from scripts/content.
__pycache__/
