# modus-vivendi-deuteranopia, from https://protesilaos.com/emacs/modus-themes
# For red-green colour blindness (deuteranopia, protanopia): blues and
# yellows, never red against green; danger is orange. WCAG AAA.

background = #000000
text       = #ffffff
muted      = #989898
selection  = #2f447f
primary    = #00bcff
secondary  = #6ae4b9
accent     = #79a8ff
danger     = #ffa00f
code       = #2fafff
warning    = #cabf00
