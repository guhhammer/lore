#!/usr/bin/env bash
#
# make — format, lint, test and build lore, then copy the release binary
# to app/.
#
#   cli/make        cargo fmt, cargo clippy, cargo test, cargo build,
#                   cargo build --release, then app/lore
#   cli/make -h     this text
#
# Stops at the first step that fails. clippy fails on any warning.
# Exit status: 0 everything passed, 1 a step failed, 2 a usage error.

set -euo pipefail

case "${1:-}" in
  "") ;;
  -h|--help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;;
  *) echo "make: unknown argument '$1' (try -h)" >&2; exit 2 ;;
esac

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() { echo "▸ $*"; "$@" || { echo "✗ failed: $*" >&2; exit 1; }; }

step cargo fmt
step cargo clippy --all-targets -- -D warnings
step cargo test
step cargo build
step cargo build --release

mkdir -p app
step cp target/release/lore app/lore
echo "✓ app/lore"
